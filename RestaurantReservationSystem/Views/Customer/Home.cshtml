@{
    ViewData["Title"] = "Trang cá nhân";
}
@section Scripts {
    <link rel="stylesheet" href="~/css/Home/HomePage.css" asp-append-version="true" />
}
<div class="hero-section">
    <div class="hero-overlay">
        <div class="hero-content">
            <h1 class="hero-title">HÒA MÌNH VÀO CHÚNG TỚI TRONG KHÔNG GIAN ẨM THỰC Ý DIỆU KỲ</h1>
            <p class="hero-description">
                FoodZero mang tinh túy của ẩm thực Ý đến bàn ăn của bạn, nơi mỗi món ăn đều được chế biến từ những nguyên liệu tươi ngon và công thức truyền thống lâu đời. Từ mì Ý làm thủ công đến các món đặc sản nướng lò củi, chúng tôi tạo ra trải nghiệm ẩm áp và chân thực cho mỗi thực khách. Hãy đặt bàn và tận hưởng hương vị nước Ý được tái hiện một cách mới mẻ.
            </p>
            <a href="/Login" class="hero-button">ĐẶT BÀN NGAY</a>
        </div>
    </div>
</div>